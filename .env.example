# ── Discord Bot ──────────────────────────────────────────────
# Token del bot (Developer Portal → tu app → Bot → Reset Token)
DISCORD_BOT_TOKEN=pega-tu-token-aqui

# Servidores a observar, separados por coma (vacío = todos donde esté el bot)
SERVIDORES_OBSERVADOS=

# Canales a observar, separados por coma (vacío = todos los canales de texto)
CANALES_OBSERVADOS=

# true = al arrancar descarga el historial existente de los canales
MODO_BACKFILL=true
BACKFILL_LIMITE=500

# ── LLM ──────────────────────────────────────────────────────
# Titular: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega-tu-clave-aqui
# Respaldo automático: Groq (https://console.groq.com/keys)
GROQ_API_KEY=pega-tu-clave-aqui
# Opcionales (valores por defecto en src/config.py)
# LLM_PROVIDER=gemini
# LLM_CLASIFICACION=compacta
# LLM_TAMANO_LOTE=20
# LLM_CONCURRENCIA=3
# LLM_ESPERA_BASE=30

# ── Panel ────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=elige-una-contrasena

# ── OCI Object Storage ───────────────────────────────────────
# OCI_CONFIG_FILE=~/.oci/config
# OCI_BUCKET_NAME=communitylab-bucket
# OCI_NAMESPACE=
