# ── Discord ──────────────────────────────────────────────────
# Token de la aplicación de Discord (Developer Portal → tu app → Bot → Reset Token). La app debe estar en el servidor
# con permiso de leer el historial y con el intent MESSAGE CONTENT activo. No hace falta tener un bot corriendo:
# el panel lee los canales cuando eliges "Discord en vivo" o pulsas "Actualizar" (solo lo nuevo desde la última vez).
DISCORD_BOT_TOKEN=pega-tu-token-aqui

# Servidores a observar, separados por coma (vacío = todos donde esté la app)
SERVIDORES_OBSERVADOS=

# Canales a observar, separados por coma (vacío = todos los canales de texto y sus hilos)
CANALES_OBSERVADOS=

# Mensajes por canal en la primera lectura; después solo se traen los nuevos
DISCORD_LIMITE_POR_CANAL=100

# ── LLM ──────────────────────────────────────────────────────
# Titular: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega-tu-clave-aqui
# Respaldo automático: Groq (https://console.groq.com/keys)
GROQ_API_KEY=pega-tu-clave-aqui
# Opcionales (valores por defecto en src/config.py)
# LLM_PROVIDER=gemini
# LLM_CLASIFICACION=compacta
# LLM_TAMANO_LOTE=20
# LLM_CONCURRENCIA=3
# LLM_ESPERA_BASE=30

# ── Panel ────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=elige-una-contrasena
# Una sesión sin actividad caduca a las SESION_HORAS horas (por defecto 12)
# SESION_HORAS=12
# Tras LOGIN_INTENTOS_MAX contraseñas erróneas seguidas (mismo usuario y dirección) el ingreso se bloquea LOGIN_BLOQUEO_S segundos
# LOGIN_INTENTOS_MAX=5
# LOGIN_BLOQUEO_S=300

# ── OCI Object Storage ───────────────────────────────────────
# Con credenciales, el paquete y sus imágenes se suben al bucket; sin ellas, solo copia local.
# Opción 1: archivo de configuración de OCI
# OCI_CONFIG_FILE=~/.oci/config
# Opción 2: API key
# OCI_USER_OCID=ocid1.user.oc1..
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# OCI_FINGERPRINT=aa:bb:cc:...
# OCI_KEY_FILE=/ruta/a/oci_api_key.pem
# OCI_REGION=sa-santiago-1
# OCI_BUCKET_NAME=communitylab-bucket
# OCI_NAMESPACE=

# ── OCI Autonomous Database (opcional) ───────────────────────
# Sin OCI_DB_PASSWORD o sin la wallet se usa SQLite local (data/communitylab.db).
# La wallet se descarga de la consola de OCI y se copia en data/wallet/ (ignorada por git).
# OCI_DB_USER=ADMIN
# OCI_DB_PASSWORD=
# OCI_DB_WALLET_PATH=data/wallet/Wallet_communitylabdb
# OCI_DB_WALLET_PASSWORD=
# OCI_DB_TNS_NAME=communitylabdb_low

# ── Imágenes (Pollinations) ──────────────────────────────────
# Token gratuito de auth.pollinations.ai: quita la marca de agua y permite más imágenes por minuto
# POLLINATIONS_TOKEN=

# ── HTTPS (solo en la VM de producción; ver docs/despliegue-oci.md) ─────────────────────
# Con un dominio apuntando a la VM, deploy/actualizar.sh levanta Caddy con certificado automático y el panel
# deja de quedar abierto por HTTP. Sin esta línea todo sigue como antes (HTTP en el puerto 8510).
# DOMINIO=panel.tudominio.org
