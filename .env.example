# ── Discord Bot ──────────────────────────────────────────────
# Token del bot (Developer Portal → tu app → Bot → Reset Token)
DISCORD_BOT_TOKEN=pega-tu-token-aqui

# Servidores a observar, separados por coma (vacío = todos donde esté el bot)
SERVIDORES_OBSERVADOS=

# Canales a observar, separados por coma (vacío = todos los canales de texto)
CANALES_OBSERVADOS=

# true = al arrancar descarga el historial existente de los canales
MODO_BACKFILL=true
BACKFILL_LIMITE=500

# ── LLM (por definir: Gemini / OpenAI / Claude) ──────────────
# LLM_API_KEY=

# ── OCI Object Storage ───────────────────────────────────────
# OCI_CONFIG_FILE=~/.oci/config
# OCI_BUCKET=communitylab-bucket
# OCI_NAMESPACE=
